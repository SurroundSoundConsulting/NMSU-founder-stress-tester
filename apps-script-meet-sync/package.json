{
  "name": "nmsu-hive-mind-week1",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "clasp": "clasp -A .clasprc.json",
    "deploy:test": "npm test && node scripts/clasp.cjs push --force",
    "test:integration": "node scripts/clasp.cjs run runIntegrationTests",
    "verify": "npm run deploy:test && npm run test:integration",
    "qa:isolation": "node scripts/qa-isolation.cjs"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1"
  }
}
